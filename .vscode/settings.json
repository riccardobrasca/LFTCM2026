{

    // Show participants only the files they should work on.
    "files.exclude": {
        // Tooling and OS noise
        "**/AGENTS.md": true,
        "**/CLAUDE.md": true,
        "**/.git": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/.vscode": true,
        "**/.github": true,
        ".claude": true,
        ".devcontainer": true,
        // Build output
        "**/.lake": true,
        "**/*.olean": true,
        // Project plumbing
        ".gitignore": true,
        "lakefile.toml": true,
        "lake-manifest.json": true,
        "lean-toolchain": true,
        "LICENSE": true,
        "README.md": true,
        "img": true,
        "LFTCM2026.lean": true,
        // Helper files participants should not need to open
        "LFTCM2026/Preliminaries": true,
        "LFTCM2026/Preliminaries.lean": true
    },

    // Configure editor to insert spaces when pressing Tab
    "editor.insertSpaces": true,
    // Set the number of spaces per tab
    "editor.tabSize": 2,
    // Display vertical rulers at specified character column for readability
    "editor.rulers": [100],
    // Set the default file encoding to UTF-8
    "files.encoding": "utf8",
    // Use Unix-style line endings ('\n') by default
    "files.eol": "\n",
    // Ensure a final newline at the end of files
    "files.insertFinalNewline": true,
    // Trim final newlines at the end of files
    "files.trimFinalNewlines": true,
    // Remove any trailing whitespace on save
    "files.trimTrailingWhitespace": true,
    // Select read-only files
    "files.readonlyInclude": {
        "**/.elan/**": true,
        "**/.lake/**": true
    }
}
