{
  "name": "LFTCM2026",
  "remoteUser": "vscode",

  "build": {
    "dockerfile": "Dockerfile"
  },

  // Runs when the container is created, and also when a prebuild is computed,
  // so with prebuilds enabled mathlib is already downloaded and built.
  "onCreateCommand": "lake exe cache get! && lake build",

  // Runs after the (possibly older) prebuild is restored, to rebuild exercise
  // files that changed since it was computed. Mathlib is pinned, so the
  // prebuild's cache is still good and there is nothing to re-fetch.
  "updateContentCommand": "lake build",

  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },

  "customizations": {
    "vscode": {
      "extensions": ["leanprover.lean4"],
      "settings": {
        "files.watcherExclude": {
          "**/.lake/**": true
        }
      }
    }
  }
}
